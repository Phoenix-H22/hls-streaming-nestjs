# MySQL connection (DB_USERNAME, DB_PASSWORD and DB_DATABASE are required)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=hls
DB_PASSWORD=
DB_DATABASE=hls

# HMAC key for signed playlist and segment URLs (required)
STREAM_SECRET=

# Optional: public origin of this app, e.g. https://videos.example.com.
# When set, /secure requests must come from this app's own pages (Referer check).
APP_ORIGIN=

# Optional: Express "trust proxy" setting used to read the client IP (default: loopback)
TRUST_PROXY=loopback

# Optional: HTTP port (default: 3006)
PORT=3006
