<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>🎥 Upload Video</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        #progressWrapper { display: none; }
    </style>
</head>
<body class="bg-light">

<div class="container py-5">
    <h1 class="text-center mb-4">🎬 Upload Video for HLS Streaming</h1>

    <div id="progressWrapper" class="mb-4">
        <label class="form-label">Upload Progress</label>
        <div class="progress">
            <div id="uploadProgress" class="progress-bar" role="progressbar" style="width: 0%">0%</div>
        </div>
    </div>

    <div class="card shadow-sm mb-5">
        <div class="card-body">
            <form id="uploadForm">
                <div class="mb-3">
                    <label class="form-label">Video Title</label>
                    <input type="text" name="title" class="form-control" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Upload Destination</label>
                    <select name="upload_target" class="form-select" required>
                        <option value="server">Local Server (FFmpeg HLS)</option>
<!--                         <option value="bunny">Bunny Stream</option> -->
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Video File (.mp4)</label>
                    <input type="file" name="video" class="form-control" accept="video/mp4" required>
                </div>
                <button type="submit" class="btn btn-primary w-100">Upload & Convert</button>
            </form>
        </div>
    </div>

    <h2 class="mb-3">📂 Uploaded Videos</h2>
    <% if (videos.length > 0) { %>
        <table class="table table-bordered table-striped">
            <thead>
            <tr>
                <th>#</th>
                <th>Title</th>
                <th>Original Path</th>
                <th>Status</th>
                <th>Watch</th>
            </tr>
            </thead>
            <tbody>
            <% videos.forEach((video, index) => { %>
                <tr>
                    <td><%= index + 1 %></td>
                    <td><%= video.title %></td>
                    <td><%= video.originalPath %></td>
                    <td>
                        <span class="badge bg-<%= { completed: 'success', failed: 'danger' }[video.status] || 'secondary' %>">
                            <%= video.status %>
                        </span>
                    </td>
                    <td>
                        <% if (video.watchUrl) { %>
                            <a href="<%= video.watchUrl %>" class="btn btn-sm btn-primary">▶ Watch</a>
                        <% } else { %>
                            <span class="text-muted">Not ready</span>
                        <% } %>
                    </td>
                </tr>
            <% }); %>
            </tbody>
        </table>
    <% } else { %>
        <p class="text-muted text-center">No videos uploaded yet.</p>
    <% } %>
</div>

<script>
    const CHUNK_SIZE = 5 * 1024 * 1024;

    document.getElementById('uploadForm').addEventListener('submit', async function (e) {
        e.preventDefault();
        const form = e.target;
        const file = form.video.files[0];
        const title = form.title.value;
        const totalChunks = Math.ceil(file.size / CHUNK_SIZE);
        // One id per file keeps this upload's chunks apart from any other upload.
        const uploadId = crypto.randomUUID();
        const bar = document.getElementById('uploadProgress');
        const submit = form.querySelector('button[type="submit"]');

        submit.disabled = true;
        bar.classList.remove('bg-danger');
        document.getElementById('progressWrapper').style.display = 'block';

        for (let chunkNumber = 1; chunkNumber <= totalChunks; chunkNumber++) {
            const start = (chunkNumber - 1) * CHUNK_SIZE;
            const formData = new FormData();
            // Text fields go first so they are parsed before the file part.
            formData.append('uploadId', uploadId);
            formData.append('title', title);
            formData.append('chunkNumber', chunkNumber);
            formData.append('totalChunks', totalChunks);
            formData.append('video', file.slice(start, start + CHUNK_SIZE));

            const response = await fetch('/videos/upload-chunk', { method: 'POST', body: formData });
            if (!response.ok) {
                const error = await response.json().catch(() => ({}));
                bar.classList.add('bg-danger');
                bar.innerText = 'Upload failed: ' + [].concat(error.message || response.statusText).join(', ');
                submit.disabled = false;
                return;
            }

            const progress = Math.floor((chunkNumber / totalChunks) * 100);
            bar.style.width = progress + '%';
            bar.innerText = progress + '%';
        }

        location.reload();
    });
</script>

</body>
</html>
